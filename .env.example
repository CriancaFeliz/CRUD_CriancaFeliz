# Copie para .env somente no servidor. Nunca envie o arquivo .env ao Git.
APP_DEBUG=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=nome_do_banco
DB_USER=usuario_do_banco
DB_PASS=troque_por_uma_senha_forte
DB_CHARSET=utf8mb4

# Usada apenas se o banco for inicializado do zero.
INITIAL_ADMIN_PASSWORD=troque_por_uma_senha_forte
