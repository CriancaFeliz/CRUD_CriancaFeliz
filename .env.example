# Copie para .env no ambiente local/servidor. Nunca envie o arquivo .env ao Git.
APP_ENV=production
APP_DEBUG=false
SOCIAL_INCOME_REFERENCE=1621.00
APP_BASE_URL=https://sistema.exemplo.org
APP_TIMEZONE=America/Sao_Paulo
APP_KEY=gere_um_segredo_aleatorio_com_pelo_menos_32_caracteres

SESSION_COOKIE_SECURE=true
SESSION_TIMEOUT_SECONDS=3600

# Proteção contra tentativas repetidas de autenticação
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_BLOCK_SECONDS=900
PASSWORD_RESET_EMAIL_MAX_ATTEMPTS=3
PASSWORD_RESET_IP_MAX_ATTEMPTS=10
PASSWORD_RESET_WINDOW_SECONDS=3600

# Recuperação de senha. O servidor precisa oferecer um transporte mail() seguro.
MAIL_ENABLED=false
MAIL_FROM=nao-responda@exemplo.org

DB_HOST=localhost
DB_PORT=3306
DB_NAME=nome_do_banco
DB_USER=usuario_do_banco
DB_PASS=troque_por_uma_senha_forte
DB_CHARSET=utf8mb4

# Usadas uma única vez pelo comando tools/maintenance/create_admin.php.
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@exemplo.org
INITIAL_ADMIN_PASSWORD=troque_por_uma_senha_forte
