<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent directory browsing
    Options -Indexes

    # Never expose local configuration, backups, logs or documentation.
    <FilesMatch "^\\.">
        Require all denied
    </FilesMatch>

    <FilesMatch "\\.(?:env|ini|log|sql|sh|md|zip|tar|gz|bak)$">
        Require all denied
    </FilesMatch>

    # Block direct web access to internal/runtime folders.
    RewriteRule ^(tools|database|data|var|docker)(/|$) - [F,L]

    # Forward all requests for non-existent files or directories to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>

<FilesMatch "^(\.dockerignore|\.gitattributes|Dockerfile|docker-compose\.yml)$">
    Require all denied
</FilesMatch>
