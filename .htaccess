<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent directory browsing
    Options -Indexes

    # Never expose local configuration, backups, logs or documentation.
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>

    <FilesMatch "\.(?:env|ini|log|sql|sh|md|zip|tar|gz|bak|ya?ml|json|ps1|txt)$">
        Require all denied
    </FilesMatch>

    # Block direct web access to internal/runtime folders.
    RewriteRule ^(app|tools|tests|database|data|var|docker|docs|\.git|\.github|assets/samples)(/|$) - [F,L]
    RewriteRule ^uploads/(documents|profiles)(/|$) - [F,L]
    RewriteRule ^uploads/[^/]+\.(?:jpe?g|png|gif|webp)$ - [F,L,NC]

    # Forward all requests for non-existent files or directories to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>

<FilesMatch "^(\.dockerignore|\.gitattributes|Dockerfile|docker-compose\.yml)$">
    Require all denied
</FilesMatch>
